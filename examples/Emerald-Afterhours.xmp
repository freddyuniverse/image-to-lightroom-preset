      <crs:Description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Emerald Afterhours v2: stronger contrast and warmer non-RAW white balance. Inspired by an editorial portrait with emerald shadows, warm skin and vivid reds. Non-RAW Temp slider +10; exposure and camera profile preserved. Inferred grade; not rendered or import-tested in Lightroom.</rdf:li>
        </rdf:Alt>
      </crs:Description>
